# Optional LLM provider (OpenAI-compatible; Groq-style endpoint shown as example)
LLM_PROVIDER=openai_compatible
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant
LLM_API_KEY=

# Local embedding model; first use downloads weights from Hugging Face
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
DEFAULT_K=5

# Retriever-specific score threshold. The starter default is provisional, not calibrated.
REFUSAL_THRESHOLD=0.012
